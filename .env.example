NODE_ENV=development
API_PORT=3000
BOT_WORKER_PORT=3001
DATABASE_URL=postgres://film_bot:film_bot@localhost:5432/film_bot
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=replace-with-a-database-password
REDIS_PASSWORD=replace-with-a-redis-password
BOT_TOKEN=0000000000:replace-with-test-bot-token
BOT_USERNAME=replace_with_test_bot
ADMIN_TELEGRAM_USER_ID=123456789
TELEGRAM_STORAGE_CHAT_ID=-1000000000000
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
MEDIA_SIGNING_SECRET=replace-with-a-separate-32-character-secret
TELEGRAM_INIT_DATA_TTL_SECONDS=900
USER_SESSION_TTL_SECONDS=3600
ADMIN_SESSION_TTL_SECONDS=7200
REDIS_COMMAND_TIMEOUT_MS=1000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_ADMIN_MAX_REQUESTS=240
RATE_LIMIT_MEDIA_MAX_REQUESTS=180
MEDIA_UPSTREAM_TIMEOUT_MS=15000
MEDIA_MAX_BYTES=10000000
BOT_USE_WEBHOOK=false
MINI_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_ENABLE_MOCKS=true
MINI_APP_DOMAIN=mini-app.example.com
ADMIN_APP_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
